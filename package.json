{
  "name": "interlocking",
  "version": "4.0.0",
  "description": "Shared browser-side GTFS/map modules for the gtfs.zone apps, consumed as a git dependency shipping raw TypeScript",
  "type": "module",
  "license": "AGPL-3.0",
  "files": [
    "src",
    "scripts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/ --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write src/ scripts/",
    "check:exports": "tsx scripts/check-exports.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:exports",
    "commit": "cz commit"
  },
  "peerDependencies": {
    "@leeoniya/ufuzzy": "*",
    "gtfs-realtime-bindings": "*",
    "jszip": "*",
    "maplibre-gl": ">=6.4.1 <7",
    "papaparse": "*"
  },
  "peerDependenciesMeta": {
    "gtfs-realtime-bindings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "gtfs-realtime-bindings": "^2.2.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.11",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
