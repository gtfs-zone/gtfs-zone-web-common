{
  "name": "gtfs-zone-web-common",
  "version": "7.14.1",
  "description": "Shared browser-side GTFS/map modules for the gtfs.zone apps, consumed as a git dependency shipping raw TypeScript",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.20.0",
  "files": [
    "src",
    "scripts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/ tests/ --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ tests/ --fix",
    "format": "prettier --write src/ scripts/ tests/",
    "check:exports": "tsx scripts/check-exports.ts",
    "test": "tsx --test tests/*.test.ts",
    "knip": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run check:exports && pnpm run test && pnpm run check-spec",
    "commit": "cz commit",
    "vuln": "sh scripts/vuln-gate.sh",
    "check-spec": "tsx scripts/check-spec.ts"
  },
  "peerDependencies": {
    "@leeoniya/ufuzzy": "*",
    "@maplibre/geojson-vt": "*",
    "@maplibre/vt-pbf": "*",
    "fflate": "*",
    "gtfs-realtime-bindings": "*",
    "gtfs-zone-vocab": "*",
    "maplibre-gl": ">=6.11.2 <7",
    "papaparse": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "gtfs-realtime-bindings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "gtfs-zone-vocab": "github:gtfs-zone/gtfs-zone-vocab#v0.2.0",
    "knip": "^6.39.0",
    "maplibre-gl": "^6.11",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.7"
  }
}
